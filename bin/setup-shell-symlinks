#!/usr/bin/env bash
#
# setup-shell-symlinks
# Creates symlinks for shell configuration files from dotfiles repo to home directory.
# Safe to run multiple times - skips existing symlinks.
#

set -e

DOTFILES_DIR="$HOME/.icloud-drive/dotfiles"

# Ensure .icloud-drive symlink exists
if [ ! -L "$HOME/.icloud-drive" ]; then
    echo "Creating .icloud-drive symlink..."
    ln -s "$HOME/Library/Mobile Documents/com~apple~CloudDocs" "$HOME/.icloud-drive"
fi

# Create ~/.config if it doesn't exist
mkdir -p "$HOME/.config"

# Helper function to create symlinks
link_file() {
    local src="$1"
    local dest="$2"

    if [ -L "$dest" ]; then
        echo "✓ $dest (already linked)"
    elif [ -e "$dest" ]; then
        echo "⚠ $dest exists but is not a symlink - skipping (backup manually if needed)"
    elif [ -e "$src" ] || [ -d "$src" ]; then
        ln -s "$src" "$dest"
        echo "→ $dest (created)"
    else
        echo "⏭ $dest (source not found: $src)"
    fi
}

xml_escape() {
    local s="$1"
    s="${s//&/&amp;}"
    s="${s//</&lt;}"
    s="${s//>/&gt;}"
    printf '%s' "$s"
}

# launchd cannot read iCloud Drive, so the plist is a generated file holding
# absolute paths and the sccache settings from .zshenv; rerun after changing them.
write_sccache_plist() {
    local dest="$HOME/Library/LaunchAgents/com.fbartho.sccache-server.plist"
    local log="$HOME/Library/Logs/sccache-server.log"
    local settings sccache dir size idle

    settings="$(HOME="$HOME" zsh -fc 'source "$1" && print -r -- "$(command -v sccache)" && print -r -- "$SCCACHE_DIR" && print -r -- "$SCCACHE_CACHE_SIZE" && print -r -- "$SCCACHE_IDLE_TIMEOUT"' zsh "$DOTFILES_DIR/.zshenv")" || {
        echo "⏭ $dest (could not read $DOTFILES_DIR/.zshenv)"
        return 0
    }
    { read -r sccache; read -r dir; read -r size; read -r idle; } <<< "$settings"
    if [ -z "$sccache" ]; then
        echo "⏭ $dest (sccache not installed)"
        return 0
    fi

    local tmp
    tmp="$(mktemp)"
    cat > "$tmp" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.fbartho.sccache-server</string>
	<key>ProgramArguments</key>
	<array>
		<string>$(xml_escape "$sccache")</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>SCCACHE_START_SERVER</key>
		<string>1</string>
		<key>SCCACHE_NO_DAEMON</key>
		<string>1</string>
		<key>SCCACHE_DIR</key>
		<string>$(xml_escape "$dir")</string>
		<key>SCCACHE_CACHE_SIZE</key>
		<string>$(xml_escape "$size")</string>
		<key>SCCACHE_IDLE_TIMEOUT</key>
		<string>$(xml_escape "$idle")</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>StandardOutPath</key>
	<string>$(xml_escape "$log")</string>
	<key>StandardErrorPath</key>
	<string>$(xml_escape "$log")</string>
</dict>
</plist>
EOF

    if [ ! -L "$dest" ] && cmp -s "$tmp" "$dest"; then
        rm "$tmp"
        echo "✓ $dest (already current)"
        return 0
    fi
    mkdir -p "$(dirname "$dest")"
    rm -f "$dest"
    mv "$tmp" "$dest"
    chmod 644 "$dest"
    echo "→ $dest (written; reload with launchctl bootout/bootstrap)"
}

echo "Setting up shell symlinks..."
echo ""

# Shared shell config
echo "=== Shared ==="
link_file "$DOTFILES_DIR/.shell-common.sh" "$HOME/.shell-common.sh"
link_file "$DOTFILES_DIR/.aliases.sh" "$HOME/.aliases.sh"
link_file "$DOTFILES_DIR/.aliases.fish" "$HOME/.aliases.fish"
link_file "$DOTFILES_DIR/.aliases.nu" "$HOME/.aliases.nu"

# Zsh config files
echo ""
echo "=== Zsh ==="
link_file "$DOTFILES_DIR/.zshenv" "$HOME/.zshenv"
link_file "$DOTFILES_DIR/.zprofile" "$HOME/.zprofile"
link_file "$DOTFILES_DIR/.zshrc" "$HOME/.zshrc"
link_file "$DOTFILES_DIR/.zsh_plugins.txt" "$HOME/.zsh_plugins.txt"

# Fish config directory
echo ""
echo "=== Fish ==="
link_file "$DOTFILES_DIR/config/fish" "$HOME/.config/fish"

# Nushell config directory
echo ""
echo "=== Nushell ==="
link_file "$DOTFILES_DIR/config/nushell" "$HOME/.config/nushell"

# Starship config
echo ""
echo "=== Starship ==="
link_file "$DOTFILES_DIR/config/starship.toml" "$HOME/.config/starship.toml"

# Ghostty config
echo ""
echo "=== Ghostty ==="
link_file "$DOTFILES_DIR/config/ghostty" "$HOME/.config/ghostty"

# JavaScript package managers
echo ""
echo "=== JavaScript ==="
link_file "$DOTFILES_DIR/config/nvm/default-packages" "${NVM_DIR:-$HOME/.nvm}/default-packages"
link_file "$DOTFILES_DIR/.yarnrc" "$HOME/.yarnrc"
link_file "$DOTFILES_DIR/.yarnrc.yml" "$HOME/.yarnrc.yml"
# pnpm reads $XDG_CONFIG_HOME/pnpm/rc, or the Library path when XDG_CONFIG_HOME is unset
mkdir -p "$HOME/.config/pnpm" "$HOME/Library/Preferences/pnpm"
link_file "$DOTFILES_DIR/config/pnpm/rc" "$HOME/.config/pnpm/rc"
link_file "$DOTFILES_DIR/config/pnpm/rc" "$HOME/Library/Preferences/pnpm/rc"

# Launch agents
echo ""
echo "=== launchd ==="
write_sccache_plist

echo ""
echo "Done!"
