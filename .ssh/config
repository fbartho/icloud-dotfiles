Host *
  ServerAliveInterval 60
  SendEnv LANG LC_*
  AddKeysToAgent yes
  UseKeychain yes

Match Originalhost matrix Exec "ifconfig | grep 10.0.1"
  Hostname 10.0.1.111
  Port 2222
Host matrix 
  Hostname fbartho-matrix.synology.me
  Port 2222

Host matrix
  # HostName fbartho-matrix.synology.me
  User fbartho
  ForwardAgent yes
  UseKeychain yes

Host matrix-tunnel
  HostName fbartho-matrix.synology.me
  User fbartho
  Port 2222
  ForwardAgent yes
  UseKeychain yes
  LocalForward 9000 127.0.0.1:9000
  LocalForward 9001 127.0.0.1:9001
  LocalForward 9002 127.0.0.1:9002
  LocalForward 9003 127.0.0.1:9003
  LocalForward 9004 127.0.0.1:9004
